# BDO Keep — единственный env (корень репозитория)
# cp .env.example .env

HOST_PORT=3000
POSTGRES_PORT=5432

POSTGRES_DB=bdokeep
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Nitro → Postgres (роль bdokeep_app, не суперюзер).
# В compose для web задаётся NUXT_DATABASE_URL на db:5432.
# Для npm run dev на хосте (и то же имя для runtimeConfig):
DATABASE_URL=postgres://bdokeep_app:your-super-secret-and-long-postgres-password@127.0.0.1:5432/bdokeep
NUXT_DATABASE_URL=postgres://bdokeep_app:your-super-secret-and-long-postgres-password@127.0.0.1:5432/bdokeep

# Пароль модерации предложений гайда (/admin/proposals)
ADMIN_PASSWORD=changeme
NUXT_ADMIN_PASSWORD=changeme
