# BDO Keep — единственный env (корень репозитория)
# cp .env.example .env

HOST_PORT=3000
API_PORT=8000
ADMINER_PORT=3001

POSTGRES_DB=bdokeep
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Must be ≥32 chars; anon JWT below is signed with this secret (demo keys)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Browser → PostgREST on host
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8000
