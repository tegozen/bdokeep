# BDO Keep — единственный env (корень репозитория)
# cp .env.example .env

HOST_PORT=3000
POSTGRES_PORT=5432

POSTGRES_DB=bdokeep
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Nitro → Postgres (роль bdokeep_app). В compose для web подставляется на db:5432 сам.
# Для npm run dev на хосте:
DATABASE_URL=postgres://bdokeep_app:your-super-secret-and-long-postgres-password@127.0.0.1:5432/bdokeep

# Пароль модерации (/admin/proposals)
ADMIN_PASSWORD=changeme
