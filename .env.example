# BDO Keep — единственный env (корень репозитория)
# cp .env.example .env

HOST_PORT=3000

POSTGRES_DB=bdokeep
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Пароль роли bdokeep_app (Nitro). Отдельный от POSTGRES_PASSWORD.
BDOKEEP_APP_PASSWORD=your-distinct-app-role-password

# Для npm run dev / drizzle-kit на хосте нужен проброс порта db (или URL на docker network).
DATABASE_URL=postgres://bdokeep_app:your-distinct-app-role-password@127.0.0.1:5432/bdokeep

# Superuser URL для drizzle-kit generate/pull/migrate с хоста (если порт 5432 проброшен).
# В compose сервис migrate использует trust: postgres://postgres@127.0.0.1:5432/...
# MIGRATE_DATABASE_URL=postgres://postgres:your-super-secret-and-long-postgres-password@127.0.0.1:5432/bdokeep
# Переиграть все catalog seeds при следующем compose up (по умолчанию skip по sha256 в drizzle.__catalog_seeds):
# FORCE_SEED=1

# Пароль bootstrap-суперадмина (логин всегда `admin`). Обязателен; в production нельзя changeme/password/admin/123456.
ADMIN_PASSWORD=replace-with-a-strong-password

# Секрет подписи JWT в cookie bdo_admin (не пароль!). В production ≥32 символа; ≠ ADMIN_PASSWORD.
# openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# 1 только за reverse proxy, который выставляет X-Forwarded-For (иначе spoofable)
TRUST_PROXY=0

# Публичный origin сайта (без trailing slash). Нужен для canonical / OG / sitemap.
# В production обязателен, напр. https://example.com
# NUXT_PUBLIC_SITE_URL=https://example.com

# 0 = отключить gzip в Nitro (если сжатие уже на nginx)
# NITRO_COMPRESS=0

# Лимиты под маленький VPS (~4 CPU / 6G; idle уже ~1 ядро + ~4G)
# Билду остаётся ~1 ядро и <2G — не ставьте heap выше ~768–1024
BUILD_CPU_COUNT=1
BUILD_NODE_MAX_OLD_SPACE=768
# Runtime-лимиты контейнера web
WEB_CPUS=1.0
WEB_MEM_LIMIT=512m
