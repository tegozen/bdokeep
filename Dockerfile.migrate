# Migrate + catalog seed + app role sync (single job on compose up).
# CMD → db/migrate-entry.ts → drizzle migrate → seed (hash ledger) → sync role.
# network_mode: service:db → trust postgres@127.0.0.1
FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json .npmrc ./
# Need tsx + drizzle-orm; full tree (short-lived migrate image).
RUN npm ci --engine-strict=false

COPY drizzle.config.ts ./
COPY db ./db
COPY drizzle ./drizzle

ENV NODE_ENV=production
# FORCE_SEED=1 re-applies all catalog fixtures ignoring drizzle.__catalog_seeds hashes.
CMD ["npx", "tsx", "db/migrate-entry.ts"]
